Description: Fix strict C99 build and libnotify linkage
 Replace the GNU typeof extension used by the sidebar navigation with
 a named C99 structure. Also link the graphical executable against
 libnotify because the application uses notify_init(),
 notify_notification_new(), and notify_notification_show().
Author: Firdaus Siregar <iam@firda.uz>
Origin: upstream
Forwarded: not-needed
Last-Update: 2026-09-04

--- sysupdater-1.0.2.orig/CMakeLists.txt
+++ sysupdater-1.0.2/CMakeLists.txt
@@ -10,6 +10,7 @@ include(GNUInstallDirs)
 
 find_package(PkgConfig REQUIRED)
 pkg_check_modules(GTK3 REQUIRED IMPORTED_TARGET gtk+-3.0)
+pkg_check_modules(LIBNOTIFY REQUIRED IMPORTED_TARGET libnotify)
 
 add_executable(sysupdater
     src/main.c
@@ -39,7 +40,10 @@ target_include_directories(sysupdater PR
     src/views/pages
 )
 
-target_link_libraries(sysupdater PRIVATE PkgConfig::GTK3)
+target_link_libraries(sysupdater PRIVATE
+    PkgConfig::GTK3
+    PkgConfig::LIBNOTIFY
+)
 
 add_executable(sysupdate
     src/cli_main.c
--- sysupdater-1.0.2.orig/src/views/components/sidebar.c
+++ sysupdater-1.0.2/src/views/components/sidebar.c
@@ -7,9 +7,16 @@ AppContext *ctx;
 char lang[16];
 } LangData;
 
+typedef struct {
+    AppContext *ctx;
+    const char *page;
+} NavData;
+
 static void on_sidebar_btn_clicked(GtkButton *btn, gpointer user_data) {
-struct { AppContext *ctx; const char *page; } *nav = user_data;
-controller_switch_page(nav->ctx, nav->page);
+    (void)btn;
+
+    NavData *nav = (NavData *)user_data;
+    controller_switch_page(nav->ctx, nav->page);
 }
 
 static void on_about_btn_clicked(GtkButton *btn, gpointer user_data) {
@@ -63,7 +70,7 @@ for (int i = 0; i < 9; i++) {
     gtk_box_pack_start(GTK_BOX(box), *nav_items[i].lbl, FALSE, FALSE, 0);
     gtk_container_add(GTK_CONTAINER(btn), box);
 
-    struct { AppContext *ctx; const char *page; } *nav = g_new0(typeof(*nav), 1);
+    NavData *nav = g_new0(NavData, 1);
     nav->ctx = ctx;
     nav->page = nav_items[i].page;
 
